# =============================================================================
# Workshop Registration - staging environment  (template: copy via `pnpm env:init`, then edit)
# Real file: env/.env.staging (gitignored). Real process env vars always win.
# Select the environment with APP_ENV (defaults to "development").
# =============================================================================
# !!! Replace every CHANGE_ME_* value before use. The API refuses to boot with
# CHANGE_ME secrets, localhost CORS origins or THROTTLE_DISABLED=true outside development.
# Generate a secret:  openssl rand -hex 32

# --- General ---------------------------------------------------------------
# Environment name; picks env/.env.<APP_ENV>. One of: development | staging | production
APP_ENV=staging

# --- API (apps/api) --------------------------------------------------------
# Port the API listens on (inside the container as well).
PORT=3000
# Postgres connection for the API when it runs ON THE HOST (pnpm dev, prisma, tests).
# Inside docker compose the API gets its own URL built from POSTGRES_* (host "postgres"),
# so this host-style value is NOT used by the compose api container.
# Note: URL-encode special characters in the password.
DATABASE_URL=postgresql://workshop_registration:CHANGE_ME_DB_PASSWORD@localhost:5434/workshop_registration_staging?schema=public
# Redis connection for the API when run on the host (compose uses redis://redis:6379 internally).
REDIS_URL=redis://localhost:6380
# HMAC secret used to sign JWTs (>= 32 chars, no CHANGE_ME outside development).
JWT_SECRET=CHANGE_ME_staging_jwt_secret_use_openssl_rand_hex_32
# Token lifetime: seconds as a number, or a string like 15m, 8h, 7d.
JWT_EXPIRES_IN=8h
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=https://staging.workshops.example.com
# Express "trust proxy": true/false/hop-count/subnet. true when behind nginx / a load balancer.
TRUST_PROXY=true
# Disable application rate limiting. Must stay false in staging/production.
THROTTLE_DISABLED=false
# Run migrations + idempotent demo seed on container start (docker-entrypoint.sh).
SEED_ON_START=false

# --- Postgres / Redis (docker compose) ------------------------------------
POSTGRES_USER=workshop_registration
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=workshop_registration_staging
# Host ports published by docker-compose.dev.yml (deps for local `pnpm dev`).
POSTGRES_PORT=5434
REDIS_PORT=6380

# --- Edge: nginx (apps/web image) ------------------------------------------
# Host port the web/nginx container is published on.
WEB_PORT=8080
# Where nginx proxies /api/ (host:port, resolved at container start; compose service "api").
API_UPSTREAM=api:3000
# DNS resolver nginx uses to re-resolve the upstream (127.0.0.11 = Docker's embedded DNS).
DNS_RESOLVER=127.0.0.11

# --- Web (apps/web, build time - baked into the bundle, never put secrets here) ---
# What the BROWSER calls. "/api" = same origin via nginx / the Vite proxy.
# May be an absolute https URL (e.g. an API Gateway URL) in other environments.
VITE_API_BASE_URL=/api
# Dev-server only: where the Vite proxy forwards /api.
VITE_API_PROXY_TARGET=http://localhost:3000
# Display name of the app.
VITE_APP_NAME=Workshop Registration (staging)
