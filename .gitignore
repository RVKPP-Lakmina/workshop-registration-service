# Dependencies
node_modules
.pnp
.pnp.js

# Environment files: real files in env/ hold secrets; only the *.example templates are committed
env/.env.*
!env/.env.*.example
.env
.env.local
.env.*.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

infra/aws/environments/*.tfvars
.terraform/
