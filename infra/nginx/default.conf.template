# nginx image template -> /etc/nginx/conf.d/default.conf (http {} context).
# envsubst fills ONLY ${API_UPSTREAM} and ${DNS_RESOLVER} (NGINX_ENVSUBST_FILTER).
#
# Rate-limit design (shared-office-IP reasoning):
#   The whole front desk usually sits behind ONE public IP, so per-IP limits at
#   the edge must be generous: they only exist to stop floods/abuse, not to
#   police individual users. Fine-grained limits (per user id, per IP+email for
#   login) are enforced by the app (@nestjs/throttler + Redis) where the
#   identity is known. Only the login endpoint gets a strict per-IP edge limit,
#   because credential stuffing is the one case where IP is the right key.

limit_req_zone $binary_remote_addr zone=api:10m   rate=30r/s;
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=perip:10m;

limit_req_status  429;
limit_conn_status 429;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_vary on;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;

server {
    listen 80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Resolver (default: Docker embedded DNS); lets nginx start even if `api` is not up yet and
    # re-resolves after the api container is recreated.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    limit_conn perip 50;
    client_max_body_size 1m;

    # Security headers (repeat in nested locations that call add_header)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Strict per-IP limit for login only: 5/min, burst 5 (so a shared office can
    # still log a few people in at shift start). Exact match beats /api/.
    location = /api/auth/login {
        limit_req zone=login burst=5 nodelay;
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 30s;
    }

    # Generous: 30 r/s steady, burst 60, for the whole office IP.
    location /api/ {
        limit_req zone=api burst=60 nodelay;
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 30s;
    }

    # Vite emits content-hashed files under /assets: cache for a year.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # index.html (and SPA fallback) must never be cached so deploys are picked up.
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;
    }

    location / {
        try_files $uri /index.html;
    }
}
