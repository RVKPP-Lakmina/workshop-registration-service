# production environment.  terraform plan -var-file=environments/production.tfvars
# Copy to environments/production.tfvars (gitignored). Keep backend_url in sync with the API origin and
# cors_allowed_origins with CORS_ORIGINS in env/.env.production. Use a separate state per environment.
environment = "production"
aws_region  = "us-east-1"

# Origin that serves /api (ALB / ECS service), no trailing slash.
backend_url = "https://api-origin.example.com"

# Browser origins allowed by CORS.
cors_allowed_origins = ["https://workshops.example.com"]

# API Gateway throttling (requests/second and burst).
default_rate_limit  = 100
default_burst_limit = 200
login_rate_limit    = 2
login_burst_limit   = 5

log_retention_days = 90
